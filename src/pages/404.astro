---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { workProjects } from '../data/projects';
import { vfabit } from '../data/vfabit';

const cases = [
  ...workProjects.map((p) => ({ name: p.name, href: `/work/${p.slug}/` })),
  { name: vfabit.name, href: `/projects/${vfabit.slug}/` },
];
---

<BaseLayout title={`Page not found | ${site.name}`} noindex>
  <section class="page nf">
    <h1>Page not found</h1>
    <p class="lead">
      This address doesn’t match any page. It may have moved, or there may be a typo.
    </p>
    <p class="links">
      <a class="link" href="/">
        Go to the home page
      </a>
      <a class="link" href="/#contact">
        Contact me
      </a>
    </p>
    <div class="cases">
      <h2>Case studies</h2>
      <ul>
        {cases.map((p) => (
          <li>
            <a class="link" href={p.href}>
              {p.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    gap: 20px;
    padding-block: clamp(4rem, 3rem + 6vw, 8rem);
  }

  .lead {
    max-width: 34rem;
    color: var(--ink-2);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
  }

  .cases {
    display: grid;
    gap: 12px;
    margin-top: 32px;
  }

  .cases h2 {
    font-size: 1.25rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    list-style: none;
  }
</style>
