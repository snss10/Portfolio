---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, nav } from '../data/site';
import { workProjects, sideProjects } from '../data/projects';
import { vfabit } from '../data/vfabit';

const cases = [
  ...workProjects.map((p) => ({
    name: p.name,
    sub: p.fullName,
    href: `/work/${p.slug}/`,
    tone: p.tone,
  })),
  {
    name: vfabit.name,
    sub: vfabit.fullName,
    href: `/projects/${vfabit.slug}/`,
    tone: sideProjects.find((p) => p.name === vfabit.name)?.tone ?? 'blue',
  },
];
---

<BaseLayout title={`Page not found | ${site.name}`} noindex>
  <section class="page nf">
    <h1>Page not found</h1>
    <p class="lead muted">
      This address doesn’t match any page on the site. It may have moved, or there may be a typo.
      Here’s everything that is here:
    </p>

    <div class="where">
      <nav aria-labelledby="sections-h">
        <h2 id="sections-h">The home page</h2>
        <ul>
          <li>
            <a class="link" href="/">
              Start at the top
            </a>
          </li>
          {nav.map((item) => (
            <li>
              <a class="link" href={`/#${item.id}`}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <nav aria-labelledby="cases-h">
        <h2 id="cases-h">Case studies</h2>
        <ul>
          {cases.map((c) => (
            <li class={`tone-${c.tone}`}>
              <a class="link" href={c.href}>
                {c.name}
              </a>
              <span class="muted">{c.sub}</span>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    gap: 18px;
    padding-block: clamp(3rem, 2rem + 5vw, 6rem);
  }

  .lead {
    max-width: 38rem;
    font-size: var(--fs-lead);
  }

  .where {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 32px;
    margin-top: 24px;
  }

  h2 {
    margin-bottom: 12px;
    font-size: 1.125rem;
  }

  ul {
    display: grid;
    gap: 10px;
  }

  li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 14px;
  }

  li .muted {
    font-size: var(--fs-small);
  }

  @media (max-width: 700px) {
    .where {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
