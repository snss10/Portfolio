---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sketch from '../../components/Sketch.astro';
import CaseHeader from '../../components/CaseHeader.astro';
import CasePager from '../../components/CasePager.astro';
import Toc from '../../components/Toc.astro';
import { workProjects, type WorkProject } from '../../data/projects';
import { site } from '../../data/site';
import { ids, breadcrumbs } from '../../lib/schema';

export function getStaticPaths() {
  const n = workProjects.length;
  return workProjects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: workProjects[(i - 1 + n) % n],
      next: workProjects[(i + 1) % n],
    },
  }));
}

interface Props {
  project: WorkProject;
  prev: WorkProject;
  next: WorkProject;
}

const { project: p, prev, next } = Astro.props;

const title = `${p.name}: ${p.fullName} | ${site.name}`;
const description = `${p.tagline} A case study by ${site.name}.`;
const path = `/work/${p.slug}/`;

const facts = [
  { label: 'Role', value: p.role },
  { label: 'When', value: p.rolePeriod },
  ...(p.context ? [{ label: 'For', value: p.context }] : []),
  { label: 'At', value: site.company },
  { label: 'Code', value: 'Private' },
];

const sections = [
  { id: 'what', label: 'What it does' },
  { id: 'how', label: 'How it works' },
  { id: 'built', label: 'What I built' },
];

const flowLabel = `${p.name}, step by step: ${p.flow.map((s) => s.title).join(', then ')}.`;

const base = Astro.site ?? new URL(Astro.url.origin);
const { person, website } = ids(base);
const jsonLd = [
  {
    '@type': 'WebPage',
    '@id': new URL(`${path}#webpage`, base).href,
    url: new URL(path, base).href,
    name: title,
    description,
    inLanguage: 'en',
    isPartOf: { '@id': website },
    author: { '@id': person },
    about: {
      '@type': 'CreativeWork',
      name: p.name,
      description: p.tagline,
      creator: { '@id': person },
      keywords: p.stack.join(', '),
    },
  },
  breadcrumbs(base, [
    [site.name, '/'],
    ['Work', '/#work'],
    [p.name, path],
  ]),
];
---

<BaseLayout
  title={title}
  description={description}
  image={`/og/work-${p.slug}.png`}
  imageAlt={`${p.name} case study: ${p.tagline}`}
  type="article"
  jsonLd={jsonLd}
>
  <article class={`page tone-${p.tone}`}>
    <CaseHeader
      crumbs={[
        { label: 'Home', href: '/' },
        { label: 'Work', href: '/#work' },
      ]}
      tone={p.tone}
      name={p.name}
      fullName={p.fullName}
      tagline={p.tagline}
      facts={facts}
      stack={p.stack}
    />

    <div class="figure">
      <Sketch
        animate
        flow={{
          label: flowLabel,
          steps: p.flow.map((s) => ({ title: s.title, sub: s.sub })),
          edges: p.edges,
          notes: p.notes,
          tone: p.tone,
          seed: p.slug.length * 7,
        }}
        maxScale={1.15}
        caption={`How ${p.name} works. The handwritten notes are mine.`}
      />
    </div>

    <div class="case-layout">
      <Toc items={sections} />

      <div class="case-body">
        <section id="what" aria-labelledby="what-h">
          <h2 id="what-h">What it does</h2>
          {p.overview.map((para) => (
            <p>{para}</p>
          ))}
          {p.metrics.length > 0 && (
            <ul class="ticks results">
              {p.metrics.map((m) => (
                <li>
                  <strong>{m.value}</strong> {m.label}
                </li>
              ))}
            </ul>
          )}
        </section>

        <section id="how" aria-labelledby="how-h">
          <h2 id="how-h">How it works</h2>
          <ol class="steps">
            {p.flow.map((s) => (
              <li>
                <h3>{s.title}</h3>
                <p>{s.detail}</p>
              </li>
            ))}
          </ol>
        </section>

        <section id="built" aria-labelledby="built-h">
          <h2 id="built-h">What I built</h2>
          <ul class="ticks">
            {p.built.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </section>
      </div>
    </div>

    <CasePager
      about={p.name}
      note="The code is private, so this page stays at the level of detail in my resume."
      label="More case studies"
      start={{
        dir: 'Previous case study',
        name: prev.name,
        sub: prev.fullName,
        href: `/work/${prev.slug}/`,
        tone: prev.tone,
      }}
      end={{
        dir: 'Next case study',
        name: next.name,
        sub: next.fullName,
        href: `/work/${next.slug}/`,
        tone: next.tone,
      }}
    />
  </article>
</BaseLayout>

<style>
  article {
    padding-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .figure {
    margin-bottom: clamp(2.5rem, 2rem + 3vw, 4.5rem);
    padding-block: clamp(1rem, 0.5rem + 2vw, 2rem);
    border-block: 1px solid var(--rule);
  }

  .figure :global(svg) {
    margin-inline: auto;
  }

  .figure :global(figcaption) {
    margin-inline: auto;
    text-align: center;
  }

  .results {
    margin-top: 6px;
  }
</style>
