---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sketch from '../../components/Sketch.astro';
import CaseHeader from '../../components/CaseHeader.astro';
import CasePager from '../../components/CasePager.astro';
import Toc from '../../components/Toc.astro';
import { vfabit as v } from '../../data/vfabit';
import { sideProjects, workProjects } from '../../data/projects';
import { site } from '../../data/site';
import { ids, breadcrumbs } from '../../lib/schema';

const card = sideProjects.find((p) => p.name === v.name);
const tone = card?.tone ?? 'blue';
const title = `${v.name}: ${v.fullName} | ${site.name}`;
const description = `${v.tagline} A side project by ${site.name}.`;
const path = `/projects/${v.slug}/`;

// The stack moves into chips in the header; the other facts stay as rows.
const stackFact = v.facts.find((f) => f.label === 'Built with');
const facts = v.facts.filter((f) => f !== stackFact).map(({ label, value }) => ({ label, value }));
const stack = stackFact ? stackFact.value.split(', ') : [];

const sections = [
  { id: 'what', label: 'What it is' },
  { id: 'rules', label: 'Rules it enforces' },
  { id: 'matching', label: 'Matching requests to shops' },
  { id: 'scan', label: 'Reading 3D models' },
  { id: 'drawings', label: 'Reading drawings' },
  { id: 'engineering', label: 'Engineering' },
  { id: 'stack', label: 'Stack' },
];

const firstWork = workProjects[0];
const base = Astro.site ?? new URL(Astro.url.origin);
const { person, website } = ids(base);
const jsonLd = [
  {
    '@type': 'WebPage',
    '@id': new URL(`${path}#webpage`, base).href,
    url: new URL(path, base).href,
    name: title,
    description,
    inLanguage: 'en',
    isPartOf: { '@id': website },
    author: { '@id': person },
    about: {
      '@type': 'CreativeWork',
      name: v.name,
      description: v.tagline,
      creator: { '@id': person },
      keywords: stack.join(', '),
    },
  },
  breadcrumbs(base, [
    [site.name, '/'],
    ['Side projects', '/#projects'],
    [v.name, path],
  ]),
];
---

<BaseLayout
  title={title}
  description={description}
  image={`/og/project-${v.slug}.png`}
  imageAlt={`${v.name}: ${v.fullName}`}
  type="article"
  jsonLd={jsonLd}
>
  <article class={`page tone-${tone}`}>
    <CaseHeader
      crumbs={[
        { label: 'Home', href: '/' },
        { label: 'Side projects', href: '/#projects' },
      ]}
      tone={tone}
      name={v.name}
      fullName={v.fullName}
      tagline={v.tagline}
      facts={facts}
      stack={stack}
    />

    <div class="figure">
      <Sketch
        animate
        flow={{ ...v.orderFlow, tone }}
        caption="How an order runs, from request to delivery. The handwritten notes are rules the platform enforces."
      />
    </div>

    <div class="case-layout">
      <Toc items={sections} />

      <div class="case-body">
        <section id="what" aria-labelledby="what-h">
          <h2 id="what-h">What it is</h2>
          {v.overview.map((para) => (
            <p>{para}</p>
          ))}
        </section>

        <section id="rules" aria-labelledby="rules-h">
          <h2 id="rules-h">Rules the platform enforces</h2>
          <ul class="ticks">
            {v.rules.map((r) => (
              <li>{r}</li>
            ))}
          </ul>
        </section>

        <section id="matching" aria-labelledby="matching-h">
          <h2 id="matching-h">Matching a request to shops</h2>
          <ul class="ticks">
            {v.matching.map((m) => (
              <li>{m}</li>
            ))}
          </ul>
        </section>

        <section id="scan" aria-labelledby="scan-h">
          <h2 id="scan-h">Reading 3D models</h2>
          <div class="inline-figure">
            <Sketch
              flow={{ ...v.scanFlow, tone }}
              caption="How a STEP file is scanned. The 3D model is ready before measuring finishes."
            />
          </div>
          <ul class="ticks">
            {v.scan.map((s) => (
              <li>{s}</li>
            ))}
          </ul>
        </section>

        <section id="drawings" aria-labelledby="drawings-h">
          <h2 id="drawings-h">Reading drawings</h2>
          <p>A beta feature, used by the operations team only.</p>
          <ul class="ticks">
            {v.drawings.map((d) => (
              <li>{d}</li>
            ))}
          </ul>
        </section>

        <section id="engineering" aria-labelledby="engineering-h">
          <h2 id="engineering-h">Engineering</h2>
          <div class="groups">
            {v.engineering.map((g) => (
              <div>
                <h3>{g.title}</h3>
                <ul class="ticks">
                  {g.points.map((pt) => (
                    <li>{pt}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <section id="stack" aria-labelledby="stack-h">
          <h2 id="stack-h">Stack</h2>
          <dl class="stack-list">
            {v.stack.map((s) => (
              <div>
                <dt>{s.layer}</dt>
                <dd>{s.tools}</dd>
              </div>
            ))}
          </dl>
        </section>
      </div>
    </div>

    <CasePager
      about={v.name}
      note="The code is private, so this page covers what the product does and how it is built."
      label="More projects"
      start={{
        dir: 'Other side project',
        name: 'DBeast',
        sub: 'A PostgreSQL MCP server for AI assistants',
        href: '/projects/dbeast/',
        tone: 'green',
      }}
      end={{
        dir: 'Work at Ideyalabs',
        name: firstWork.name,
        sub: firstWork.fullName,
        href: `/work/${firstWork.slug}/`,
        tone: firstWork.tone,
      }}
    />
  </article>
</BaseLayout>

<style>
  article {
    padding-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .figure {
    margin-bottom: clamp(2.5rem, 2rem + 3vw, 4.5rem);
    padding-block: clamp(1rem, 0.5rem + 2vw, 2rem);
    border-block: 1px solid var(--rule);
  }

  .figure :global(svg),
  .inline-figure :global(svg) {
    margin-inline: auto;
  }

  .figure :global(figcaption) {
    margin-inline: auto;
    text-align: center;
  }

  .inline-figure {
    margin-block: 8px;
  }
</style>
