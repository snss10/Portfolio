---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sketch from '../../components/Sketch.astro';
import CaseHeader from '../../components/CaseHeader.astro';
import CasePager from '../../components/CasePager.astro';
import Toc from '../../components/Toc.astro';
import { vfabit as v } from '../../data/vfabit';
import { sideProjects, workProjects } from '../../data/projects';
import { site } from '../../data/site';
import { ids, breadcrumbs } from '../../lib/schema';

const tone = sideProjects.find((p) => p.name === v.name)?.tone ?? 'blue';
const title = `${v.name}: ${v.fullName} | ${site.name}`;
const description = `${v.tagline} A side project by ${site.name}.`;
const path = `/projects/${v.slug}/`;

// The stack is listed under the facts; the other facts stay as rows.
const stackFact = v.facts.find((f) => f.label === 'Built with');
const facts = v.facts.filter((f) => f !== stackFact);
const stack = stackFact ? stackFact.value.split(', ') : [];

const sections = [
  { id: 'what', label: 'What it is' },
  { id: 'how', label: 'How it works' },
  { id: 'decisions', label: 'Design decisions' },
];

const firstWork = workProjects[0];
const base = Astro.site ?? new URL(Astro.url.origin);
const { person, website } = ids(base);
const jsonLd = [
  {
    '@type': 'WebPage',
    '@id': new URL(`${path}#webpage`, base).href,
    url: new URL(path, base).href,
    name: title,
    description,
    inLanguage: 'en',
    isPartOf: { '@id': website },
    author: { '@id': person },
    about: {
      '@type': 'CreativeWork',
      name: v.name,
      description: v.tagline,
      creator: { '@id': person },
      keywords: stack.join(', '),
    },
  },
  breadcrumbs(base, [
    [site.name, '/'],
    ['Side projects', '/#projects'],
    [v.name, path],
  ]),
];
---

<BaseLayout
  title={title}
  description={description}
  image={`/og/project-${v.slug}.png`}
  imageAlt={`${v.name}: ${v.fullName}`}
  type="article"
  jsonLd={jsonLd}
>
  <article class={`page tone-${tone}`}>
    <CaseHeader
      crumbs={[
        { label: 'Home', href: '/' },
        { label: 'Side projects', href: '/#projects' },
      ]}
      tone={tone}
      name={v.name}
      fullName={v.fullName}
      tagline={v.tagline}
      facts={facts}
      stack={stack}
    />

    <div class="figure">
      <Sketch
        animate
        flow={{ ...v.orderFlow, tone }}
        caption="How an order runs, from request to delivery. The handwritten notes are rules the platform enforces."
      />
    </div>

    <div class="case-layout">
      <Toc items={sections} />

      <div class="case-body">
        <section id="what" aria-labelledby="what-h">
          <h2 id="what-h">What it is</h2>
          {v.overview.map((para) => (
            <p>{para}</p>
          ))}
        </section>

        <section id="how" aria-labelledby="how-h">
          <h2 id="how-h">How it works</h2>
          <ol class="steps">
            {v.steps.map((s) => (
              <li>
                <h3>{s.title}</h3>
                <p>{s.detail}</p>
              </li>
            ))}
          </ol>
        </section>

        <section id="decisions" aria-labelledby="decisions-h">
          <h2 id="decisions-h">Design decisions</h2>
          <dl class="decisions">
            {v.decisions.map((d) => (
              <div>
                <dt>{d.title}</dt>
                <dd>{d.why}</dd>
              </div>
            ))}
          </dl>
        </section>
      </div>
    </div>

    <CasePager
      about={v.name}
      note="The code is private, so this page covers what the product does and how it is designed."
      label="More projects"
      start={{
        dir: 'Other side project',
        name: 'DBeast',
        sub: 'A PostgreSQL MCP server for AI assistants',
        href: '/projects/dbeast/',
        tone: 'green',
      }}
      end={{
        dir: 'Work at Ideyalabs',
        name: firstWork.name,
        sub: firstWork.fullName,
        href: `/work/${firstWork.slug}/`,
        tone: firstWork.tone,
      }}
    />
  </article>
</BaseLayout>

<style>
  article {
    padding-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .figure {
    margin-bottom: clamp(2.5rem, 2rem + 3vw, 4.5rem);
    padding-block: clamp(1rem, 0.5rem + 2vw, 2rem);
    border-block: 1px solid var(--rule);
  }

  .figure :global(svg) {
    margin-inline: auto;
  }

  .figure :global(figcaption) {
    margin-inline: auto;
    text-align: center;
  }

  .decisions {
    display: grid;
    gap: 20px;
    max-width: 42rem;
  }

  .decisions div {
    display: grid;
    gap: 4px;
    padding-left: 18px;
    border-left: 3px solid var(--tone);
  }

  .decisions dt {
    font-weight: 720;
  }

  .decisions dd {
    color: var(--ink-2);
  }
</style>
