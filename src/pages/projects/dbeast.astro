---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sketch from '../../components/Sketch.astro';
import CaseHeader from '../../components/CaseHeader.astro';
import CasePager from '../../components/CasePager.astro';
import Toc from '../../components/Toc.astro';
import { dbeast as d } from '../../data/dbeast';
import { vfabit } from '../../data/vfabit';
import { sideProjects } from '../../data/projects';
import { site } from '../../data/site';
import { ids, breadcrumbs } from '../../lib/schema';

const tone = sideProjects.find((p) => p.name === d.name)?.tone ?? 'green';
const vfabitTone = sideProjects.find((p) => p.name === vfabit.name)?.tone ?? 'blue';
const title = `${d.name}: ${d.fullName} | ${site.name}`;
const description = `${d.tagline} An open-source project by ${site.name}.`;
const path = `/projects/${d.slug}/`;

// The stack is listed under the facts; the other facts stay as rows.
const stackFact = d.facts.find((f) => f.label === 'Built with');
const facts = d.facts.filter((f) => f !== stackFact);
const stack = stackFact ? stackFact.value.split(', ') : [];

const sections = [
  { id: 'what', label: 'What it is' },
  { id: 'how', label: 'How it works' },
  { id: 'writing', label: 'Writing about it' },
];

const base = Astro.site ?? new URL(Astro.url.origin);
const { person, website } = ids(base);
const jsonLd = [
  {
    '@type': 'WebPage',
    '@id': new URL(`${path}#webpage`, base).href,
    url: new URL(path, base).href,
    name: title,
    description,
    inLanguage: 'en',
    isPartOf: { '@id': website },
    author: { '@id': person },
    about: {
      '@type': 'SoftwareSourceCode',
      name: d.name,
      description: d.tagline,
      codeRepository: d.links[0].href,
      programmingLanguage: 'Python',
      license: 'https://opensource.org/licenses/MIT',
      author: { '@id': person },
    },
  },
  breadcrumbs(base, [
    [site.name, '/'],
    ['Side projects', '/#projects'],
    [d.name, path],
  ]),
];
---

<BaseLayout
  title={title}
  description={description}
  image={`/og/project-${d.slug}.png`}
  imageAlt={`${d.name}: ${d.fullName}`}
  type="article"
  jsonLd={jsonLd}
>
  <article class={`page tone-${tone}`}>
    <CaseHeader
      crumbs={[
        { label: 'Home', href: '/' },
        { label: 'Side projects', href: '/#projects' },
      ]}
      tone={tone}
      name={d.name}
      fullName={d.fullName}
      tagline={d.tagline}
      facts={facts}
      stack={stack}
    />

    <div class="figure">
      <Sketch
        animate
        flow={{ ...d.flow, tone }}
        caption="How a request travels from the assistant to the database. The handwritten notes are mine."
      />
    </div>

    <div class="case-layout">
      <Toc items={sections} />

      <div class="case-body">
        <section id="what" aria-labelledby="what-h">
          <h2 id="what-h">What it is</h2>
          <p>{d.overview}</p>
          <p>
            It runs locally, so there is nothing to host. It is listed on the official MCP Registry,
            Glama, PulseMCP and other MCP directories.
          </p>
          <p class="links">
            {[
              ...d.links,
              ...d.listings.map((l) => ({ label: `${l.name} listing`, href: l.href })),
            ].map((l) => (
              <a class="link" href={l.href} target="_blank" rel="noopener">
                {l.label}
                <span class="visually-hidden"> (opens in a new tab)</span>
              </a>
            ))}
          </p>
        </section>

        <section id="how" aria-labelledby="how-h">
          <h2 id="how-h">How it works</h2>
          <ol class="steps">
            {d.steps.map((s) => (
              <li>
                <h3>{s.title}</h3>
                <p>{s.detail}</p>
              </li>
            ))}
          </ol>
        </section>

        <section id="writing" aria-labelledby="writing-h">
          <h2 id="writing-h">Writing about it</h2>
          <ul class="ticks">
            {d.writing.map((w) => (
              <li>
                <a class="link" href={w.href} target="_blank" rel="noopener">
                  {w.title}
                  <span class="visually-hidden"> (opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </div>

    <CasePager
      about={d.name}
      note="The code is open source, so you can read all of it on GitHub."
      label="More projects"
      start={{
        dir: 'Back to',
        name: 'Side projects',
        sub: 'Everything I build in my own time',
        href: '/#projects',
        tone,
      }}
      end={{
        dir: 'Other side project',
        name: vfabit.name,
        sub: vfabit.fullName,
        href: `/projects/${vfabit.slug}/`,
        tone: vfabitTone,
      }}
    />
  </article>
</BaseLayout>

<style>
  article {
    padding-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .figure {
    margin-bottom: clamp(2.5rem, 2rem + 3vw, 4.5rem);
    padding-block: clamp(1rem, 0.5rem + 2vw, 2rem);
    border-block: 1px solid var(--rule);
  }

  .figure :global(svg) {
    margin-inline: auto;
  }

  .figure :global(figcaption) {
    margin-inline: auto;
    text-align: center;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
  }
</style>
