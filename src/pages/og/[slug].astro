---
/**
 * Social preview cards (1200x630) and app icons, screenshotted by
 * scripts/generate-images.mjs into /public. These routes are only built
 * when OG_CARDS=1, so they never ship with the real site.
 */
import '@fontsource-variable/schibsted-grotesk/wght.css';
import '@fontsource/kalam/400.css';
import '@fontsource/kalam/700.css';
import '../../styles/global.css';
import Sketch from '../../components/Sketch.astro';
import { site, intro, lifecycle } from '../../data/site';
import { workProjects } from '../../data/projects';
import { vfabit } from '../../data/vfabit';

interface CaseCard {
  by: string;
  name: string;
  fullName: string;
  tagline: string;
  note?: string;
}

export function getStaticPaths() {
  if (process.env.OG_CARDS !== '1') return [];
  const lastNote = (notes?: { text: string }[]) => notes?.[notes.length - 1]?.text;
  return [
    { params: { slug: 'home' }, props: { kind: 'home' as const } },
    { params: { slug: 'icon' }, props: { kind: 'icon' as const } },
    ...workProjects.map((p) => ({
      params: { slug: `work-${p.slug}` },
      props: {
        kind: 'case' as const,
        card: {
          by: `Case study by ${site.name}`,
          name: p.name,
          fullName: p.fullName,
          tagline: p.tagline,
          note: lastNote(p.notes),
        },
      },
    })),
    {
      params: { slug: `project-${vfabit.slug}` },
      props: {
        kind: 'case' as const,
        card: {
          by: `A project by ${site.name}`,
          name: vfabit.name,
          fullName: vfabit.fullName,
          tagline: vfabit.tagline,
          note: 'nothing ships unpaid',
        },
      },
    },
  ];
}

type Props = { kind: 'home' } | { kind: 'icon' } | { kind: 'case'; card: CaseCard };

const props = Astro.props;
const underline = 'M4 9 C 60 3, 140 12, 220 6 S 330 5, 396 10';
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{site.name}</title>
  </head>
  <body>
    {props.kind === 'icon' && (
      <div class="icon">
        <span class="s hand">S</span>
        <svg viewBox="0 0 400 20" preserveAspectRatio="none" aria-hidden="true">
          <path d={underline} />
        </svg>
      </div>
    )}

    {props.kind === 'home' && (
      <main class="card home">
        <h1>{site.name}</h1>
        <p class="line">{intro.line}</p>
        <Sketch flow={lifecycle} class="og-sketch" />
      </main>
    )}

    {props.kind === 'case' && (
      <main class="card work">
        <p class="by">{props.card.by}</p>
        <div>
          <h1>{props.card.name}</h1>
          <p class="full">{props.card.fullName}</p>
        </div>
        <p class="line">{props.card.tagline}</p>
        {props.card.note && (
          <p class="note hand">
            {props.card.note}
            <svg viewBox="0 0 400 20" preserveAspectRatio="none" aria-hidden="true">
              <path d={underline} />
            </svg>
          </p>
        )}
      </main>
    )}
  </body>
</html>

<style is:global>
  html,
  body {
    width: 100%;
    height: 100%;
    margin: 0;
    background: var(--paper);
  }

  .icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 100vw;
    height: 100vh;
    background: var(--paper);
  }

  .icon .s {
    font-size: 78vmin;
    font-weight: 700;
    line-height: 1;
    color: var(--ink);
    transform: translateY(-4%);
  }

  .icon svg {
    position: absolute;
    left: 18%;
    bottom: 13%;
    width: 64%;
    height: 9vmin;
    overflow: visible;
  }

  .icon path,
  .note path {
    fill: none;
    stroke: var(--marker);
    stroke-linecap: round;
    stroke-width: 7vmin;
    vector-effect: none;
  }

  .card {
    box-sizing: border-box;
    width: 1200px;
    height: 630px;
    padding: 64px 72px;
    display: flex;
    flex-direction: column;
    background: var(--paper);
    color: var(--ink);
    overflow: hidden;
  }

  .card h1 {
    font-size: 88px;
    letter-spacing: -0.04em;
  }

  .home .line {
    max-width: 30ch;
    margin-top: 22px;
    font-size: 32px;
    line-height: 1.32;
  }

  .home .og-sketch {
    margin-top: auto;
  }

  .work {
    gap: 18px;
  }

  .work .by {
    color: var(--ink-2);
    font-size: 24px;
  }

  .work h1 {
    margin-top: 30px;
    font-size: 104px;
  }

  .work .full {
    margin-top: 10px;
    color: var(--ink-2);
    font-size: 30px;
  }

  .work .line {
    max-width: 34ch;
    margin-top: auto;
    font-size: 34px;
    line-height: 1.3;
  }

  .note {
    position: absolute;
    right: 72px;
    top: 64px;
    margin: 0;
    color: var(--marker);
    font-size: 34px;
    font-weight: 700;
  }

  .note svg {
    display: block;
    width: 100%;
    height: 14px;
    margin-top: 2px;
    overflow: visible;
  }

  .note path {
    stroke-width: 4;
  }
</style>
