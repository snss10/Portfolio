---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import WorkIndex from '../components/WorkIndex.astro';
import SideProjects from '../components/SideProjects.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';
import { site } from '../data/site';
import { ids } from '../lib/schema';

const base = Astro.site ?? new URL(Astro.url.origin);
const { person, website } = ids(base);
const jsonLd = [
  {
    '@type': 'ProfilePage',
    '@id': new URL('/#profilepage', base).href,
    url: new URL('/', base).href,
    name: site.seo.title,
    description: site.seo.description,
    inLanguage: 'en',
    isPartOf: { '@id': website },
    mainEntity: { '@id': person },
    about: { '@id': person },
  },
];
---

<BaseLayout jsonLd={jsonLd}>
  <Hero />

  <section id="work" class="sec page" aria-labelledby="work-title">
    <header class="sec-head">
      <h2 id="work-title">Work</h2>
      <p>
        Systems I built at Ideyalabs, newest first. The code is private, so each case study explains
        what I built and how it works.
      </p>
    </header>
    <div class="sec-body">
      <WorkIndex />
    </div>
  </section>

  <section id="projects" class="sec page" aria-labelledby="projects-title">
    <header class="sec-head">
      <h2 id="projects-title">Side projects</h2>
      <p>Things I build in my own time.</p>
    </header>
    <div class="sec-body">
      <SideProjects />
    </div>
  </section>

  <section id="experience" class="sec page" aria-labelledby="experience-title">
    <header class="sec-head">
      <h2 id="experience-title">Experience</h2>
      <p>
        I joined Ideyalabs as an intern in June 2024 and have built agent systems there since: an AI
        testing platform first, then product-planning and delivery platforms, and now document AI
        for a logistics client.
      </p>
    </header>
    <div class="sec-body">
      <Experience />
    </div>
  </section>

  <section id="skills" class="sec page" aria-labelledby="skills-title">
    <header class="sec-head">
      <h2 id="skills-title">Skills</h2>
      <p>The tools from my resume, grouped by what they’re for, plus what my side projects use.</p>
    </header>
    <div class="sec-body">
      <Skills />
    </div>
  </section>

  <section id="contact" class="sec page" aria-labelledby="contact-title">
    <header class="sec-head">
      <h2 id="contact-title">Contact</h2>
    </header>
    <div class="sec-body">
      <Contact />
    </div>
  </section>
</BaseLayout>
