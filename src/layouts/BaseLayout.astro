---
import '@fontsource-variable/schibsted-grotesk/wght.css';
import '@fontsource/kalam/400.css';
import '@fontsource/kalam/700.css';
import '../styles/global.css';
import textFont from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import handFont from '@fontsource/kalam/files/kalam-latin-700-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { baseGraph } from '../lib/schema';

interface Props {
  title?: string;
  description?: string;
  /** Path to a 1200x630 image in /public. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  /** This page's own structured-data nodes, added to the site-wide graph. */
  jsonLd?: Record<string, unknown>[];
  /** Pages like 404 should not be indexed. */
  noindex?: boolean;
}

const {
  title = site.seo.title,
  description = site.seo.description,
  image = '/og/home.png',
  imageAlt = `${site.name}, ${site.role}`,
  type = 'website',
  jsonLd = [],
  noindex = false,
} = Astro.props;

const base = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, base);
const imageUrl = new URL(image, base);
const graph = { '@context': 'https://schema.org', '@graph': [...baseGraph(base), ...jsonLd] };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="keywords" content={site.seo.keywords.join(', ')} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        <meta name="robots" content="index, follow, max-image-preview:large" />
        <link rel="canonical" href={canonical} />
      </>
    )}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15171a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={handFont} as="font" type="font/woff2" crossorigin />

    <script is:inline>
      // Before first paint: mark that JavaScript runs, and apply a saved theme so the page never flashes.
      document.documentElement.classList.add('js');
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
