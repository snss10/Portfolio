---
/**
 * The top of every case study: a breadcrumb trail back to the home page, the
 * name and one-line summary, and a facts card (role, dates, stack).
 */
import type { Tone } from '../lib/sketch';

export interface Fact {
  label: string;
  value: string;
}

interface Props {
  /** The trail above the title, e.g. Home › Work. The current page is added last. */
  crumbs: { label: string; href: string }[];
  eyebrow: string;
  tone: Tone;
  name: string;
  fullName: string;
  tagline: string;
  facts: Fact[];
  stack: string[];
}

const { crumbs, eyebrow, tone, name, fullName, tagline, facts, stack } = Astro.props;
---

<header class={`case-head tone-${tone}`}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <ol>
      {crumbs.map((c) => (
        <li>
          <a href={c.href}>{c.label}</a>
        </li>
      ))}
      <li>
        <span aria-current="page">{name}</span>
      </li>
    </ol>
  </nav>

  <div class="grid">
    <div class="intro">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{name}</h1>
      <p class="full">{fullName}</p>
      <p class="tagline">{tagline}</p>
    </div>

    <aside class="spec card" aria-label={`${name} at a glance`}>
      <dl>
        {facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>
      <div class="stack">
        <p class="label">Built with</p>
        <ul class="chips">
          {stack.map((t) => (
            <li class="chip">{t}</li>
          ))}
        </ul>
      </div>
    </aside>
  </div>
</header>

<style>
  .case-head {
    display: grid;
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    padding-block: clamp(1.75rem, 1rem + 2.5vw, 3rem) clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 0;
    color: var(--ink-3);
    font-size: var(--fs-small);
    list-style: none;
  }

  .crumbs li + li::before {
    content: '/';
    margin-inline: 10px;
    color: var(--line-2);
  }

  .crumbs a {
    color: var(--ink-2);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .crumbs [aria-current] {
    color: var(--ink);
    font-weight: 600;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(1.75rem, 1rem + 3vw, 4rem);
  }

  .intro {
    display: grid;
    justify-items: start;
    gap: 14px;
  }

  h1 {
    font-size: clamp(2.5rem, 1.8rem + 3vw, 4rem);
  }

  .full {
    color: var(--ink-2);
    font-size: var(--fs-lead);
    font-weight: 600;
  }

  .tagline {
    max-width: 38ch;
    margin-top: 6px;
    font-size: clamp(1.1875rem, 1rem + 0.7vw, 1.5rem);
    line-height: 1.45;
    letter-spacing: -0.012em;
  }

  .spec {
    gap: 18px;
    border-top: 4px solid var(--tone);
  }

  dl {
    display: grid;
    gap: 12px;
  }

  dl div {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 12px;
  }

  dt,
  .label {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding-top: 3px;
  }

  dd {
    font-weight: 600;
  }

  .stack {
    display: grid;
    gap: 10px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
