---
/**
 * The top of every case study: a breadcrumb trail back to the home page, the
 * name and one-line summary, and the facts (role, dates, stack) beside them,
 * ruled in the project's ink.
 */
import type { Tone } from '../lib/sketch';

export interface Fact {
  label: string;
  value: string;
}

interface Props {
  /** The trail above the title, e.g. Home, Work. The current page is added last. */
  crumbs: { label: string; href: string }[];
  tone: Tone;
  name: string;
  fullName: string;
  tagline: string;
  facts: Fact[];
  stack: string[];
}

const { crumbs, tone, name, fullName, tagline, facts, stack } = Astro.props;
---

<header class={`case-head tone-${tone}`}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <ol>
      {crumbs.map((c) => (
        <li>
          <a href={c.href}>{c.label}</a>
        </li>
      ))}
      <li>
        <span aria-current="page">{name}</span>
      </li>
    </ol>
  </nav>

  <div class="grid">
    <div class="intro">
      <h1>{name}</h1>
      <p class="full">{fullName}</p>
      <p class="tagline">{tagline}</p>
    </div>

    <dl class="facts">
      {facts.map((f) => (
        <div>
          <dt>{f.label}</dt>
          <dd>{f.value}</dd>
        </div>
      ))}
      <div>
        <dt>Built with</dt>
        <dd>{stack.join(', ')}</dd>
      </div>
    </dl>
  </div>
</header>

<style>
  .case-head {
    display: grid;
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    padding-block: clamp(1.75rem, 1rem + 2.5vw, 3rem) clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    color: var(--ink-2);
    font-size: var(--fs-small);
  }

  .crumbs li + li::before {
    content: '/';
    margin-inline: 10px;
    color: var(--ink-2);
  }

  .crumbs a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 4px;
  }

  .crumbs a:hover {
    color: var(--ink);
    text-decoration-color: currentColor;
  }

  .crumbs [aria-current] {
    color: var(--ink);
    font-weight: 650;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(1.75rem, 1rem + 3vw, 4.5rem);
  }

  .intro {
    display: grid;
    gap: 12px;
  }

  .full {
    color: var(--ink-2);
    font-size: var(--fs-lead);
    font-weight: 600;
  }

  .tagline {
    max-width: 36ch;
    margin-top: 8px;
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.5rem);
    font-weight: 560;
    line-height: 1.4;
    letter-spacing: -0.012em;
  }

  .facts {
    display: grid;
    gap: 12px;
    padding-left: 22px;
    border-left: 3px solid var(--tone);
  }

  .facts div {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 12px;
  }

  dt {
    color: var(--ink-2);
    font-size: var(--fs-small);
    padding-top: 2px;
  }

  dd {
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
