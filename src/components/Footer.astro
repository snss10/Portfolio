---
/** Every page on the site, one click away from anywhere. */
import Logo from './Logo.astro';
import { site, nav } from '../data/site';
import { workProjects, sideProjects } from '../data/projects';
import { vfabit } from '../data/vfabit';

const year = new Date().getFullYear();
const caseStudies = [
  ...workProjects.map((p) => ({ name: p.name, href: `/work/${p.slug}/`, tone: p.tone })),
  {
    name: vfabit.name,
    href: `/projects/${vfabit.slug}/`,
    tone: sideProjects.find((p) => p.name === vfabit.name)?.tone ?? 'blue',
  },
];
---

<footer class="site-footer">
  <div class="page top">
    <div class="about">
      <a class="brand" href="/">
        <Logo size={26} />
        <span>{site.name}</span>
      </a>
      <p class="muted">
        {site.role} in {site.location.split(',')[0]}, building agent systems with LangGraph, MCP,
        RAG and FastAPI.
      </p>
    </div>

    <nav aria-label="Site map" class="cols">
      <div>
        <h2>This page</h2>
        <ul>
          {nav.map((item) => (
            <li>
              <a href={`/#${item.id}`}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2>Case studies</h2>
        <ul>
          {caseStudies.map((c) => (
            <li class={`tone-${c.tone}`}>
              <a href={c.href}>{c.name}</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2>Elsewhere</h2>
        <ul>
          <li>
            <a href={site.links.linkedin} target="_blank" rel="me noopener">
              LinkedIn<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </li>
          <li>
            <a href={site.links.github} target="_blank" rel="me noopener">
              GitHub<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${site.email}`}>Email</a>
          </li>
          <li>
            <a href={site.resume} download>
              Resume (PDF)
            </a>
          </li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="page bottom">
    <p>
      © {year} {site.name}
    </p>
    <p>
      Built with Astro. Diagrams drawn with rough.js.
      <a href={site.links.source} target="_blank" rel="noopener">
        Site source<span class="visually-hidden"> (opens in a new tab)</span>
      </a>
    </p>
    <a href="#top">Back to top</a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    font-size: var(--fs-small);
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 32px clamp(2rem, 1rem + 4vw, 5rem);
    padding-block: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .about {
    display: grid;
    align-content: start;
    gap: 12px;
    max-width: 24rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    justify-self: start;
    font-size: var(--fs-body);
    font-weight: 760;
    letter-spacing: -0.015em;
    text-decoration: none;
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  h2 {
    margin-bottom: 8px;
    font-size: var(--fs-small);
    font-weight: 740;
    letter-spacing: 0;
  }

  ul {
    display: grid;
    gap: 2px;
  }

  .cols a,
  .bottom a {
    display: inline-block;
    padding-block: 4px;
    color: var(--ink-2);
    text-decoration: none;
  }

  .cols a:hover,
  .bottom a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--tone, var(--blue));
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 24px;
    padding-block: 18px 28px;
    border-top: 1px solid var(--rule);
    color: var(--ink-2);
  }

  .bottom p a {
    margin-left: 6px;
  }

  @media (max-width: 860px) {
    .top {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 520px) {
    .cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
