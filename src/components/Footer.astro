---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="page foot">
  <p>
    © {year} {site.name}
  </p>
  <p>
    Diagrams drawn with rough.js.
    <a href={site.links.source} target="_blank" rel="noopener">
      Site source
    </a>
  </p>
</footer>

<style>
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 40px 48px;
    color: var(--ink-2);
    font-size: var(--fs-small);
  }

  a {
    margin-left: 6px;
    text-underline-offset: 4px;
  }

  a:hover {
    color: var(--ink);
  }
</style>
