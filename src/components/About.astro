---
import { employer, roles, education, certifications } from '../data/experience';
import { skillGroups } from '../data/skills';
import { getWorkProject } from '../data/projects';
---

<div class="about">
  <div class="story">
    <p class="lead">
      I joined Ideyalabs as an intern in June 2024 and have built agent systems there since: an AI
      testing platform first, then product-planning and delivery platforms, and now document AI for
      a logistics client.
    </p>
    <p>
      I studied Artificial Intelligence and Data Science at {education.school} (B.Tech,{' '}
      {education.period.replace(' – ', '–')}, CGPA 9.62).
    </p>
    <p>
      Outside work I built vFABit, a marketplace for custom machined parts, and two open-source
      tools: a PostgreSQL server for AI assistants and an on-device text rewriter for Windows.
    </p>
  </div>

  <div class="details">
    <section aria-labelledby="experience-h">
      <h3 id="experience-h">Experience</h3>
      <p class="org">
        {employer.name}, {employer.location}
      </p>
      <ol class="roles">
        {roles.map((r) => (
          <li>
            <p class="r-head">
              <span class="r-title">{r.title}</span>
              <span class="r-when">{r.period}</span>
            </p>
            <p class="r-what">{r.summary}</p>
            <p class="r-links">
              {r.projects.map((slug) => {
                const p = getWorkProject(slug);
                return p ? (
                  <a class="link" href={`/work/${p.slug}/`}>
                    {p.name}
                  </a>
                ) : null;
              })}
            </p>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="skills-h">
      <h3 id="skills-h">Skills</h3>
      <dl class="skills">
        {skillGroups.map((g) => (
          <div>
            <dt>{g.name}</dt>
            <dd>{g.skills.join(', ')}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section aria-labelledby="certs-h">
      <h3 id="certs-h">Certifications</h3>
      <ul class="certs">
        {certifications.map((c) => (
          <li>
            <span>
              {c.name}, {c.issuer}
              {c.note && <span class="muted"> ({c.note})</span>}
            </span>
            <a class="link" href={c.href} target="_blank" rel="noopener">
              Verify<span class="visually-hidden"> {c.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</div>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2.5rem, 1rem + 5vw, 6rem);
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .story {
    display: grid;
    align-content: start;
    gap: 18px;
    color: var(--ink-2);
  }

  .story .lead {
    color: var(--ink);
  }

  .details {
    display: grid;
    gap: 44px;
  }

  .details section {
    display: grid;
    gap: 14px;
  }

  h3 {
    font-size: 1.25rem;
  }

  .org {
    color: var(--ink-2);
    margin-top: -6px;
  }

  .roles {
    display: grid;
    gap: 22px;
    list-style: none;
  }

  .roles li {
    display: grid;
    gap: 4px;
    padding-left: 18px;
    border-left: 2px solid var(--line);
  }

  .roles li:first-child {
    border-left-color: var(--marker);
  }

  .r-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2px 16px;
  }

  .r-title {
    font-weight: 700;
  }

  .r-when {
    color: var(--ink-2);
    font-size: var(--fs-small);
    font-variant-numeric: tabular-nums;
  }

  .r-what {
    color: var(--ink-2);
  }

  .r-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    font-size: var(--fs-small);
  }

  .skills {
    display: grid;
    gap: 12px;
  }

  .skills div {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 4px 20px;
  }

  dt {
    font-weight: 650;
  }

  dd {
    color: var(--ink-2);
  }

  .certs {
    display: grid;
    gap: 10px;
    list-style: none;
  }

  .certs li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 16px;
  }

  @media (max-width: 860px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .skills div {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
