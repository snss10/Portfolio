---
/** The foot of a case study: a contact card, then where to go next. */
import Icon from './Icon.astro';
import { site } from '../data/site';
import type { Tone } from '../lib/sketch';

interface Item {
  /** Small line above the name, e.g. "Previous case study". */
  dir: string;
  name: string;
  sub?: string;
  href: string;
  tone?: Tone;
}

interface Props {
  /** The project the visitor just read about. */
  about: string;
  /** One line under the question, e.g. why the page stays brief. */
  note: string;
  label: string;
  start: Item;
  end: Item;
}

const { about, note, label, start, end } = Astro.props;
const mail = `mailto:${site.email}?subject=${encodeURIComponent(`About ${about}`)}`;
---

<aside class="ask board" aria-labelledby="ask-title">
  <div>
    <h2 id="ask-title">Questions about {about}?</h2>
    <p class="muted">{note}</p>
  </div>
  <div class="ask-buttons">
    <a class="btn btn-primary" href={mail}>
      <Icon name="mail" />
      Email me about {about}
    </a>
    <a class="btn btn-secondary" href={site.resume} download>
      <Icon name="download" />
      Resume (PDF)
    </a>
  </div>
</aside>

<nav class="pager" aria-label={label}>
  {[start, end].map((item, i) => (
    <a
      href={item.href}
      class:list={['card', 'is-link', i === 1 && 'end', item.tone && `tone-${item.tone}`]}
    >
      <span class="dir">
        {i === 0 && <Icon name="arrow-left" size={16} />}
        {item.dir}
        {i === 1 && <Icon name="arrow-right" size={16} />}
      </span>
      <span class="to">{item.name}</span>
      {item.sub && <span class="sub">{item.sub}</span>}
    </a>
  ))}
</nav>

<style>
  .ask {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 20px 32px;
    margin-top: clamp(3.5rem, 2.5rem + 3vw, 5rem);
    padding: clamp(24px, 1rem + 2vw, 40px);
  }

  .ask h2 {
    margin-bottom: 6px;
    font-size: clamp(1.375rem, 1.2rem + 0.7vw, 1.75rem);
  }

  .ask-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(14px, 0.8rem + 0.6vw, 20px);
    margin-top: clamp(16px, 1rem + 0.6vw, 24px);
  }

  .pager a {
    gap: 4px;
    text-decoration: none;
  }

  .end {
    justify-items: end;
    text-align: right;
  }

  .dir {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-3);
    font-size: var(--fs-small);
  }

  .to {
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    font-weight: 760;
    letter-spacing: -0.02em;
  }

  .card:hover .to {
    color: var(--tone, var(--blue));
  }

  .sub {
    color: var(--ink-2);
    font-size: var(--fs-small);
  }

  @media (max-width: 760px) {
    .ask {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .pager {
      grid-template-columns: minmax(0, 1fr);
    }

    .end {
      justify-items: start;
      text-align: left;
    }
  }
</style>
