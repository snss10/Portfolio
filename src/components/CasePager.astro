---
/** The foot of a case study: how to ask about it, then where to go next. */
import MarkerButton from './MarkerButton.astro';
import { site } from '../data/site';
import type { Tone } from '../lib/sketch';

interface Item {
  /** Small line above the name, e.g. "Previous case study". */
  dir: string;
  name: string;
  sub?: string;
  href: string;
  tone?: Tone;
}

interface Props {
  /** The project the visitor just read about. */
  about: string;
  /** One line under the question, e.g. why the page stays brief. */
  note: string;
  label: string;
  start: Item;
  end: Item;
}

const { about, note, label, start, end } = Astro.props;
const mail = `mailto:${site.email}?subject=${encodeURIComponent(`About ${about}`)}`;
---

<aside class="ask" aria-labelledby="ask-title">
  <h2 id="ask-title">Questions about {about}?</h2>
  <p class="muted">{note}</p>
  <MarkerButton href={mail} seed={about.length}>
    Email me about {about}
  </MarkerButton>
</aside>

<nav class="pager" aria-label={label}>
  {[start, end].map((item, i) => (
    <a href={item.href} class:list={['to', i === 1 && 'end', item.tone && `tone-${item.tone}`]}>
      <span class="dir">{item.dir}</span>
      <span class="name">{item.name}</span>
      {item.sub && <span class="sub">{item.sub}</span>}
    </a>
  ))}
</nav>

<style>
  .ask {
    display: grid;
    justify-items: start;
    gap: 10px;
    margin-top: clamp(3.5rem, 2.5rem + 3vw, 5rem);
    padding-top: 40px;
    border-top: 1px solid var(--rule);
  }

  .ask h2 {
    font-size: clamp(1.375rem, 1.2rem + 0.7vw, 1.75rem);
  }

  .ask :global(.mbtn) {
    margin-top: 10px;
    margin-left: -4px;
  }

  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
    padding-top: 28px;
    border-top: 1px solid var(--rule);
  }

  .to {
    display: grid;
    align-content: start;
    gap: 2px;
    text-decoration: none;
  }

  .end {
    justify-items: end;
    text-align: right;
  }

  .dir,
  .sub {
    color: var(--ink-2);
    font-size: var(--fs-small);
  }

  .name {
    font-size: clamp(1.375rem, 1.2rem + 0.7vw, 1.75rem);
    font-weight: 760;
    letter-spacing: -0.02em;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--tone, var(--blue)) 45%, transparent);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .to:hover .name {
    text-decoration-color: var(--tone, var(--blue));
  }

  @media (max-width: 560px) {
    .pager {
      grid-template-columns: minmax(0, 1fr);
    }

    .end {
      justify-items: start;
      text-align: left;
    }
  }
</style>
