---
/** Links at the foot of a case study: where to go next. */
interface Item {
  /** Small line above the name, e.g. "Previous". */
  dir: string;
  name: string;
  href: string;
}

interface Props {
  label: string;
  start: Item;
  end?: Item;
}

const { label, start, end } = Astro.props;
---

<nav class="pager" aria-label={label}>
  <a href={start.href}>
    <span class="dir">{start.dir}</span>
    <span class="to">{start.name}</span>
  </a>
  {end && (
    <a href={end.href} class="end">
      <span class="dir">{end.dir}</span>
      <span class="to">{end.name}</span>
    </a>
  )}
</nav>

<style>
  .pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-top: clamp(4rem, 3rem + 4vw, 6rem);
    padding-top: 28px;
    border-top: 2px solid var(--ink);
  }

  a {
    display: grid;
    gap: 2px;
    align-content: start;
    text-decoration: none;
  }

  .end {
    justify-items: end;
    text-align: right;
  }

  .dir {
    color: var(--ink-2);
    font-size: var(--fs-small);
  }

  .to {
    font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem);
    font-weight: 750;
    letter-spacing: -0.02em;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
    transition: text-decoration-color 0.2s var(--ease);
  }

  a:hover .to {
    text-decoration-color: var(--marker);
  }

  @media (max-width: 520px) {
    .pager {
      grid-template-columns: minmax(0, 1fr);
    }

    .end {
      justify-items: start;
      text-align: left;
    }
  }
</style>
