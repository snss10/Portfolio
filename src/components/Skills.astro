---
/** Skills as a plain list: the group, then what is in it. */
import { skillGroups } from '../data/skills';
---

<dl class="skills">
  {skillGroups.map((g) => (
    <div>
      <dt>{g.name}</dt>
      <dd>{g.skills.join(', ')}</dd>
    </div>
  ))}
</dl>

<style>
  .skills {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 48px;
  }

  .skills div {
    display: grid;
    align-content: start;
    gap: 6px;
  }

  dt {
    font-weight: 740;
  }

  dd {
    color: var(--ink-2);
  }

  @media (max-width: 640px) {
    .skills {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
