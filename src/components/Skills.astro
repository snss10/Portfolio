---
/** Skills in groups, as cards. The first group (agents and LLMs) is the widest. */
import { skillGroups } from '../data/skills';
---

<ul class="skills">
  {skillGroups.map((g, i) => (
    <li class:list={['card', { wide: i === 0 }]} data-reveal style={`--stagger:${(i % 3) * 0.06}s`}>
      <h3>{g.name}</h3>
      <ul class="chips">
        {g.skills.map((s) => (
          <li class="chip">{s}</li>
        ))}
      </ul>
    </li>
  ))}
</ul>

<style>
  .skills {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 0.8rem + 0.6vw, 20px);
    list-style: none;
  }

  .card {
    gap: 14px;
    padding: 20px 22px 22px;
  }

  .wide {
    grid-column: span 2;
  }

  h3 {
    font-size: 1.0625rem;
    font-weight: 720;
  }

  @media (max-width: 900px) {
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .skills {
      grid-template-columns: minmax(0, 1fr);
    }

    .wide {
      grid-column: auto;
    }
  }
</style>
