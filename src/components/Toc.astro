---
/**
 * "On this page": jump links to a case study's sections. It stays in view
 * beside the text on wide screens and marks the section being read.
 */
interface Props {
  items: { id: string; label: string }[];
}

const { items } = Astro.props;
---

<nav class="toc" aria-labelledby="toc-title">
  <h2 id="toc-title">On this page</h2>
  <ol>
    {items.map((item) => (
      <li>
        <a href={`#${item.id}`} data-toc={item.id}>
          {item.label}
        </a>
      </li>
    ))}
  </ol>
</nav>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
  const targets = links
    .map((a) => document.getElementById(a.dataset.toc ?? ''))
    .filter((el): el is HTMLElement => el !== null);
  if (targets.length && 'IntersectionObserver' in window) {
    const seen = new Map<string, boolean>();
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => seen.set(e.target.id, e.isIntersecting));
        const active = targets.find((t) => seen.get(t.id))?.id;
        if (!active) return;
        links.forEach((a) => {
          const on = a.dataset.toc === active;
          a.toggleAttribute('data-active', on);
          if (on) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        });
      },
      { rootMargin: '-20% 0px -65% 0px' },
    );
    targets.forEach((t) => io.observe(t));
  }
</script>

<style>
  .toc {
    position: sticky;
    top: calc(var(--header-h) + 28px);
    display: grid;
    gap: 10px;
  }

  h2 {
    font-size: var(--fs-small);
    font-weight: 740;
    letter-spacing: 0;
  }

  ol {
    display: grid;
    border-left: 1px solid var(--rule);
  }

  a {
    display: block;
    margin-left: -1px;
    padding: 6px 0 6px 14px;
    border-left: 3px solid transparent;
    color: var(--ink-2);
    font-size: var(--fs-small);
    line-height: 1.35;
    text-decoration: none;
    transition: color 0.15s;
  }

  a:hover {
    color: var(--ink);
  }

  a[data-active] {
    border-left-color: var(--tone, var(--blue));
    color: var(--ink);
    font-weight: 650;
  }

  /* Narrow screens: a short list of jump links above the text. */
  @media (max-width: 980px) {
    .toc {
      position: static;
    }

    ol {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 20px;
      border: 0;
    }

    a {
      margin: 0;
      padding: 4px 0;
      border: 0;
      text-decoration: underline;
      text-decoration-color: var(--rule);
      text-underline-offset: 4px;
    }
  }
</style>
