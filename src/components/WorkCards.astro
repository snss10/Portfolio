---
/** The four Ideyalabs systems as cards. Each card opens its case study. */
import Icon from './Icon.astro';
import { workProjects } from '../data/projects';
---

<ul class="work-grid">
  {workProjects.map((p, i) => (
    <li class={`card is-link tone-${p.tone}`} data-reveal style={`--stagger:${(i % 2) * 0.08}s`}>
      <p class="meta">
        <span class="mono">{p.rolePeriod}</span>
        {p.current && <span class="badge tone-green">Current</span>}
      </p>
      <div class="title">
        <h3>
          <a class="stretched" href={`/work/${p.slug}/`}>
            {p.name}
            <span class="visually-hidden">: case study</span>
          </a>
        </h3>
        <p class="full">{p.fullName}</p>
      </div>
      <p class="summary">{p.summary}</p>
      <ol class="flow" aria-label={`How ${p.name} works, step by step`}>
        {p.flow.map((s) => (
          <li>
            <span>{s.title}</span>
          </li>
        ))}
      </ol>
      <div class="foot">
        <p class="role">{p.role}</p>
        <span class="go" aria-hidden="true">
          Case study
          <Icon name="arrow-right" />
        </span>
      </div>
    </li>
  ))}
</ul>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 1rem + 0.6vw, 24px);
    list-style: none;
  }

  .card {
    gap: 16px;
    border-top: 4px solid var(--tone);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    color: var(--ink-3);
    font-size: var(--fs-xs);
  }

  .title {
    display: grid;
    gap: 2px;
  }

  h3 {
    font-size: clamp(1.5rem, 1.3rem + 0.7vw, 1.875rem);
    font-weight: 780;
    letter-spacing: -0.025em;
  }

  h3 a {
    text-decoration: none;
  }

  .card:hover h3 a {
    color: var(--tone);
  }

  .full {
    color: var(--ink-2);
    font-weight: 560;
  }

  .summary {
    color: var(--ink-2);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    margin-top: 4px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .role {
    color: var(--ink-3);
    font-size: var(--fs-small);
  }

  .foot .go {
    font-size: var(--fs-small);
  }

  @media (max-width: 760px) {
    .work-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
