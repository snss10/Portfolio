---
/**
 * Roles at Ideyalabs on a timeline (drawn to scale, like a trace of spans),
 * then education and certifications. Each role links to the case studies of
 * the systems built in it, in their colours.
 */
import Icon from './Icon.astro';
import { employer, roles, education, certifications, monthsSince } from '../data/experience';
import { getWorkProject } from '../data/projects';

const total = monthsSince(employer.start);
const pct = (months: number) => `${((months / total) * 100).toFixed(2)}%`;
const spans = [...roles].reverse().map((r) => ({
  ...r,
  left: pct(monthsSince(employer.start, r.start) - 1),
  width: pct(monthsSince(r.start, r.end)),
}));

const firstYear = Number(employer.start.slice(0, 4));
const ticks = [];
for (let y = firstYear + 1; y <= new Date().getFullYear(); y++) {
  ticks.push({ label: String(y), left: pct(monthsSince(employer.start, `${y}-01`) - 1) });
}
const startLabel = employer.period.split(' – ')[0];
---

<div class="exp">
  <article class="card org" aria-labelledby="org-name">
    <header class="org-head">
      <div>
        <h3 id="org-name">{employer.name}</h3>
        <p class="org-meta">
          {employer.location} · {employer.period}
        </p>
      </div>
      <span class="badge tone-green">Current employer</span>
    </header>

    <div class="trace" aria-hidden="true">
      <div class="track">
        {spans.map((s) => (
          <span class={`seg tone-${s.tone}`} style={`left:${s.left};width:${s.width}`} />
        ))}
      </div>
      <div class="ticks">
        <span class="tick start">{startLabel}</span>
        {ticks.map((t) => (
          <span class="tick" style={`left:${t.left}`}>
            {t.label}
          </span>
        ))}
        <span class="tick end">Now</span>
      </div>
    </div>

    <ol class="roles">
      {roles.map((r) => (
        <li class={`tone-${r.tone}`}>
          <div class="r-head">
            <h4>{r.title}</h4>
            <span class="r-when mono">{r.period}</span>
          </div>
          <p class="r-what">{r.summary}</p>
          <p class="r-links">
            {r.projects.map((slug) => {
              const p = getWorkProject(slug);
              return p ? (
                <a class={`go tone-${p.tone}`} href={`/work/${p.slug}/`}>
                  {p.name}
                  <span class="visually-hidden">: case study</span>
                  <Icon name="arrow-right" />
                </a>
              ) : null;
            })}
          </p>
        </li>
      ))}
    </ol>
  </article>

  <div class="side-col">
    <article class="card edu" id="education" aria-labelledby="edu-title">
      <p class="eyebrow tone-orange">Education</p>
      <h3 id="edu-title">{education.degree}</h3>
      <p class="muted">
        {education.school}, {education.location} · <span class="mono">{education.period}</span>
      </p>
      <p class="stat tone-orange">
        <span class="stat-value">{education.grade.replace('CGPA ', '')}</span>
        <span class="stat-label">CGPA</span>
      </p>
    </article>

    <article class="card certs" aria-labelledby="certs-title">
      <h3 id="certs-title" class="eyebrow tone-violet">
        Certifications
      </h3>
      <ul>
        {certifications.map((c) => (
          <li>
            <span class="c-icon">
              <Icon name="award" size={18} />
            </span>
            <span class="c-text">
              <span class="c-name">{c.name}</span>
              <span class="c-issuer">
                {c.issuer}
                {c.note && <span> · {c.note}</span>}
              </span>
            </span>
            <a class="go c-verify" href={c.href} target="_blank" rel="noopener">
              Verify
              <span class="visually-hidden">{c.name} (opens in a new tab)</span>
              <Icon name="external" size={14} />
            </a>
          </li>
        ))}
      </ul>
    </article>
  </div>
</div>

<style>
  .exp {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(16px, 1rem + 0.6vw, 24px);
    align-items: start;
  }

  .org {
    gap: 24px;
  }

  .org-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px 16px;
  }

  .org-head h3 {
    font-size: 1.375rem;
  }

  .org-meta {
    color: var(--ink-3);
    font-size: var(--fs-small);
  }

  /* The timeline: one bar per role, placed by month. */
  .trace {
    display: grid;
    gap: 8px;
  }

  .track {
    position: relative;
    height: 14px;
    border-radius: 999px;
    background: var(--surface-2);
  }

  .seg {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 999px;
    border: 2px solid var(--bg);
    background: var(--tone);
  }

  .ticks {
    position: relative;
    height: 18px;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .tick {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .tick.start {
    left: 0;
    transform: none;
  }

  .tick.end {
    right: 0;
    transform: none;
  }

  .roles {
    display: grid;
    gap: 22px;
    list-style: none;
  }

  .roles li {
    position: relative;
    display: grid;
    gap: 6px;
    padding-left: 26px;
  }

  /* A dot in the role's colour, on a thin line that joins the roles. */
  .roles li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--tone);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--tone) 16%, transparent);
  }

  .roles li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 5px;
    top: calc(0.45em + 20px);
    bottom: -18px;
    width: 2px;
    background: var(--line);
  }

  .r-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 2px 16px;
  }

  h4 {
    font-size: 1.125rem;
    font-weight: 720;
  }

  .r-when {
    color: var(--ink-3);
    font-size: var(--fs-xs);
  }

  .r-what {
    color: var(--ink-2);
  }

  .r-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    font-size: var(--fs-small);
  }

  .side-col {
    display: grid;
    gap: clamp(16px, 1rem + 0.6vw, 24px);
  }

  .edu h3 {
    font-size: 1.25rem;
  }

  .edu .stat {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .certs ul {
    display: grid;
    list-style: none;
  }

  .certs li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding-block: 12px;
  }

  .certs li + li {
    border-top: 1px solid var(--line);
  }

  .c-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--violet) 9%, var(--surface));
    color: var(--violet);
  }

  .c-text {
    display: grid;
    line-height: 1.35;
  }

  .c-name {
    font-weight: 650;
  }

  .c-issuer {
    color: var(--ink-3);
    font-size: var(--fs-small);
  }

  .c-verify {
    font-size: var(--fs-small);
  }

  @media (max-width: 960px) {
    .exp {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
