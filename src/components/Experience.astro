---
/**
 * Roles at Ideyalabs, drawn as hand-shaded bars on a timeline (to scale, by
 * month), then listed with the systems built in each. Education and
 * certifications follow.
 */
import { employer, roles, education, certifications } from '../data/experience';
import { getWorkProject } from '../data/projects';
import { renderTimeline, type TimelineSpan } from '../lib/sketch';

const short: Record<string, string> = {
  'Software Engineering Intern': 'intern',
  'Associate Software Engineer': 'associate engineer',
  'Software Engineer': 'software engineer',
};
const spans: TimelineSpan[] = [...roles].reverse().map((r) => ({
  label: short[r.title] ?? r.title.toLowerCase(),
  start: r.start,
  end: r.end,
  tone: r.tone,
}));
const wide = renderTimeline(spans, 760, 7);
const narrow = renderTimeline(spans, 360, 9);
const label = `Timeline of my roles at ${employer.name}: ${roles
  .slice()
  .reverse()
  .map((r) => `${r.title}, ${r.period}`)
  .join('; ')}.`;
---

<div class="exp">
  <figure class="timeline">
    <svg
      class="t-wide"
      viewBox={`0 0 ${wide.width} ${wide.height}`}
      role="img"
      aria-label={label}
      set:html={wide.svg}
    />
    <svg
      class="t-narrow"
      viewBox={`0 0 ${narrow.width} ${narrow.height}`}
      role="img"
      aria-label={label}
      set:html={narrow.svg}
    />
  </figure>

  <div class="org">
    <h3>{employer.name}</h3>
    <p class="muted">
      {employer.location}, {employer.period}
    </p>
  </div>

  <ol class="roles">
    {roles.map((r) => (
      <li class={`tone-${r.tone}`}>
        <div class="r-head">
          <h4>{r.title}</h4>
          <p class="r-when">{r.period}</p>
        </div>
        <p class="r-what">{r.summary}</p>
        <p class="r-links">
          {r.projects.map((slug) => {
            const p = getWorkProject(slug);
            return p ? (
              <a class={`link tone-${p.tone}`} href={`/work/${p.slug}/`}>
                {p.name} case study
              </a>
            ) : null;
          })}
        </p>
      </li>
    ))}
  </ol>

  <div class="more">
    <section id="education" aria-labelledby="education-title">
      <h3 id="education-title">Education</h3>
      <p class="degree">{education.degree}</p>
      <p class="muted">
        {education.school}, {education.location}, {education.period}
      </p>
      <p class="grade">{education.grade}</p>
    </section>

    <section aria-labelledby="certs-title">
      <h3 id="certs-title">Certifications</h3>
      <ul class="certs">
        {certifications.map((c) => (
          <li>
            <span>
              {c.name}, {c.issuer}
              {c.note && <span class="muted"> ({c.note})</span>}
            </span>
            <a class="link" href={c.href} target="_blank" rel="noopener">
              Verify<span class="visually-hidden"> {c.name} (opens in a new tab)</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</div>

<style>
  .exp {
    display: grid;
    gap: 28px;
  }

  .timeline {
    max-width: 760px;
    margin-bottom: 8px;
  }

  .timeline svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .t-narrow {
    display: none;
  }

  @media (max-width: 600px) {
    .t-wide {
      display: none;
    }

    .t-narrow {
      display: block;
    }
  }

  .org {
    display: grid;
    gap: 2px;
  }

  .org h3 {
    font-size: 1.25rem;
  }

  .roles {
    display: grid;
    gap: 30px;
    max-width: 42rem;
  }

  .roles li {
    display: grid;
    gap: 6px;
    padding-left: 18px;
    border-left: 3px solid var(--tone);
  }

  .r-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 2px 18px;
  }

  h4 {
    font-size: 1.125rem;
    font-weight: 740;
  }

  .r-when {
    color: var(--ink-2);
    font-size: var(--fs-small);
  }

  .r-what {
    color: var(--ink-2);
  }

  .r-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    font-size: var(--fs-small);
  }

  .more {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 56px;
    margin-top: 26px;
    padding-top: 36px;
    border-top: 1px solid var(--rule);
  }

  .more section {
    display: grid;
    align-content: start;
    gap: 6px;
  }

  .more h3 {
    margin-bottom: 6px;
    font-size: 1.25rem;
  }

  .degree {
    font-weight: 650;
  }

  .grade {
    color: var(--red);
    font-family: var(--font-hand);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .certs {
    display: grid;
    gap: 10px;
  }

  .certs li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 2px 16px;
  }

  @media (max-width: 760px) {
    .more {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
