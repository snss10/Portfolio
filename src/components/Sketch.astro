---
/**
 * A hand-drawn flow diagram. Renders a wide layout for desktop and a tall one
 * for phones; CSS shows the right one. With `animate`, the strokes draw
 * themselves once when the page opens (skipped for reduced motion).
 */
import { renderSketch, type SketchFlow } from '../lib/sketch';

interface Props {
  flow: SketchFlow;
  caption?: string;
  animate?: boolean;
  /** How far the desktop drawing may grow beyond its natural size. */
  maxScale?: number;
  class?: string;
}

const { flow, caption, animate = false, maxScale = 1, class: className } = Astro.props;
const { h, v } = renderSketch(flow);
---

<figure class:list={['sketch', className]} data-animate={animate ? '' : undefined}>
  <svg
    class="sk-h"
    viewBox={`0 0 ${h.width} ${h.height}`}
    style={`max-width:${Math.round(h.width * maxScale)}px`}
    role="img"
    aria-label={flow.label}
    set:html={h.svg}
  />
  <svg
    class="sk-v"
    viewBox={`0 0 ${v.width} ${v.height}`}
    style={`max-width:${v.width}px`}
    role="img"
    aria-label={flow.label}
    set:html={v.svg}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
