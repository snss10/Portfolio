---
/**
 * A hand-drawn flow diagram. By default it renders a wide layout for desktop
 * and a tall one for phones, and CSS shows the right one. `layout="vertical"`
 * always uses the tall one (for narrow columns); compact sketches always use
 * the wide one, scaled to fit. With `animate`, the strokes draw themselves
 * once when the page opens (skipped for reduced motion). Steps with an
 * `href` become links, so a diagram can be navigated.
 */
import { renderSketch, type SketchFlow } from '../lib/sketch';

interface Props {
  flow: SketchFlow;
  caption?: string;
  animate?: boolean;
  layout?: 'auto' | 'vertical' | 'horizontal';
  /** How far the drawing may grow beyond its natural size. */
  maxScale?: number;
  class?: string;
}

const { flow, caption, animate = false, maxScale = 1, class: className } = Astro.props;
const layout = flow.compact ? 'horizontal' : (Astro.props.layout ?? 'auto');
const { h, v } = renderSketch(flow);

// A drawing with links is a group of links; one without is a single image.
const interactive = flow.steps.some((s) => s.href);
const role = interactive ? 'group' : 'img';
---

<figure
  class:list={['sketch', `sketch-${layout}`, className]}
  data-animate={animate ? '' : undefined}
>
  {layout !== 'vertical' && (
    <svg
      class="sk-h"
      viewBox={`0 0 ${h.width} ${h.height}`}
      style={`max-width:${Math.round(h.width * maxScale)}px`}
      role={role}
      aria-label={flow.label}
      set:html={h.svg}
    />
  )}
  {layout !== 'horizontal' && (
    <svg
      class="sk-v"
      viewBox={`0 0 ${v.width} ${v.height}`}
      style={`max-width:${Math.round(v.width * (layout === 'vertical' ? maxScale : 1))}px`}
      role={role}
      aria-label={flow.label}
      set:html={v.svg}
    />
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>
