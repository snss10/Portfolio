---
import MarkerButton from './MarkerButton.astro';
import { site } from '../data/site';
---

<div class="contact">
  <p class="lead">Email is the best way to reach me.</p>
  <div class="email-row">
    <a class="email" href={`mailto:${site.email}`}>
      {site.email}
    </a>
    <button class="copy" type="button" data-copy={site.email}>
      Copy address
    </button>
    <span class="status hand" role="status" aria-live="polite"></span>
  </div>
  <p class="elsewhere">
    <a class="link" href={site.links.linkedin} target="_blank" rel="me noopener">
      LinkedIn<span class="visually-hidden"> (opens in a new tab)</span>
    </a>
    <a class="link" href={site.links.github} target="_blank" rel="me noopener">
      GitHub<span class="visually-hidden"> (opens in a new tab)</span>
    </a>
  </p>
  <MarkerButton href={site.resume} download seed={9}>
    Download resume (PDF)
  </MarkerButton>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    const row = button.closest('.email-row');
    const status = row?.querySelector<HTMLElement>('.status');
    let timer: number | undefined;

    const show = (message: string, copied: boolean) => {
      if (status) status.textContent = message;
      button.textContent = copied ? 'Copied' : 'Copy address';
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (status) status.textContent = '';
        button.textContent = 'Copy address';
      }, 2400);
    };

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        show('copied', true);
      } catch {
        // Clipboard blocked: select the address so the visitor can copy it themselves.
        const email = row?.querySelector('.email');
        if (email) {
          const range = document.createRange();
          range.selectNodeContents(email);
          window.getSelection()?.removeAllRanges();
          window.getSelection()?.addRange(range);
        }
        show('selected, press Ctrl+C to copy', false);
      }
    });
  });
</script>

<style>
  .contact {
    display: grid;
    justify-items: start;
    gap: 18px;
  }

  .lead {
    color: var(--ink-2);
    font-size: var(--fs-lead);
  }

  .email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 22px;
  }

  .email {
    font-size: clamp(1.625rem, 1rem + 2.4vw, 2.75rem);
    font-weight: 780;
    letter-spacing: -0.03em;
    text-decoration: underline;
    text-decoration-color: var(--blue);
    text-decoration-thickness: 3px;
    text-underline-offset: 9px;
    overflow-wrap: anywhere;
  }

  .copy {
    padding: 4px 0;
    border: 0;
    background: none;
    color: var(--ink-2);
    font-size: var(--fs-small);
    font-weight: 650;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
    cursor: pointer;
  }

  .copy:hover {
    color: var(--ink);
  }

  .status {
    color: var(--green);
    font-size: 1.1875rem;
    font-weight: 700;
  }

  .elsewhere {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 26px;
  }

  .contact :global(.mbtn) {
    margin-top: 10px;
    margin-left: -4px;
  }
</style>
