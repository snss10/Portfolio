---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<div class="contact board">
  <div class="text">
    <p class="eyebrow">Contact</p>
    <h2 id="contact-title">Get in touch</h2>
    <p class="section-intro">
      Email is the best way to reach me. You can also find me on LinkedIn and GitHub, or download my
      resume.
    </p>
  </div>

  <div class="reach">
    <div class="email-row">
      <a class="email" href={`mailto:${site.email}`}>
        {site.email}
      </a>
      <button class="btn btn-secondary btn-sm copy" type="button" data-copy={site.email}>
        <Icon name="copy" class="i-copy" />
        <Icon name="check" class="i-check" />
        <span class="copy-label">Copy</span>
      </button>
      <span class="status hand" role="status" aria-live="polite"></span>
    </div>

    <div class="buttons">
      <a class="btn btn-primary" href={`mailto:${site.email}`}>
        <Icon name="mail" />
        Email me
      </a>
      <a class="btn btn-secondary" href={site.links.linkedin} target="_blank" rel="me noopener">
        <Icon name="linkedin" />
        LinkedIn
        <span class="visually-hidden">(opens in a new tab)</span>
      </a>
      <a class="btn btn-secondary" href={site.links.github} target="_blank" rel="me noopener">
        <Icon name="github" />
        GitHub
        <span class="visually-hidden">(opens in a new tab)</span>
      </a>
      <a class="btn btn-secondary" href={site.resume} download>
        <Icon name="download" />
        Resume (PDF)
      </a>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    const box = button.closest('.reach');
    const status = box?.querySelector<HTMLElement>('.status');
    const label = button.querySelector<HTMLElement>('.copy-label');
    let timer: number | undefined;

    const show = (message: string, copied: boolean) => {
      if (status) status.textContent = message;
      if (label) label.textContent = copied ? 'Copied' : 'Copy';
      button.toggleAttribute('data-copied', copied);
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (status) status.textContent = '';
        if (label) label.textContent = 'Copy';
        button.removeAttribute('data-copied');
      }, 2400);
    };

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        show('copied to your clipboard', true);
      } catch {
        // Clipboard blocked: select the address so the visitor can copy it themselves.
        const email = box?.querySelector('.email');
        if (email) {
          const range = document.createRange();
          range.selectNodeContents(email);
          window.getSelection()?.removeAllRanges();
          window.getSelection()?.addRange(range);
        }
        show('selected, press Ctrl+C to copy', false);
      }
    });
  });
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(1.75rem, 1rem + 3vw, 4rem);
    padding: clamp(28px, 1.2rem + 3vw, 56px);
  }

  .text {
    display: grid;
    justify-items: start;
    gap: 14px;
  }

  .reach {
    display: grid;
    gap: 22px;
    padding: clamp(20px, 1rem + 1.2vw, 28px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
  }

  .email {
    font-size: clamp(1.25rem, 0.95rem + 1.3vw, 1.875rem);
    font-weight: 760;
    letter-spacing: -0.02em;
    text-decoration: underline;
    text-decoration-color: var(--blue);
    text-decoration-thickness: 3px;
    text-underline-offset: 7px;
    overflow-wrap: anywhere;
  }

  .copy :global(.i-check),
  .copy[data-copied] :global(.i-copy) {
    display: none;
  }

  .copy[data-copied] :global(.i-check) {
    display: block;
    color: var(--green);
  }

  .status {
    color: var(--green);
    font-size: 1.125rem;
    font-weight: 700;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  @media (max-width: 900px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 420px) {
    .buttons .btn {
      flex: 1 1 100%;
    }
  }
</style>
