---
import { site } from '../data/site';
---

<div class="contact">
  <h2 id="contact-title">Contact</h2>

  <div class="email-row">
    <a class="email" href={`mailto:${site.email}`}>
      {site.email}
    </a>
    <button class="copy" type="button" data-copy={site.email}>
      Copy email
    </button>
    <span class="status hand" role="status" aria-live="polite"></span>
  </div>

  <p class="links">
    <a class="link" href={site.links.linkedin} target="_blank" rel="noopener">
      LinkedIn
    </a>
    <a class="link" href={site.links.github} target="_blank" rel="noopener">
      GitHub
    </a>
    <a class="link" href={site.resume} download>
      Download resume (PDF)
    </a>
  </p>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    const status = button.parentElement?.querySelector<HTMLElement>('.status');
    let timer: number | undefined;

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        if (status) status.textContent = 'copied';
      } catch {
        // Clipboard blocked: select the address so the visitor can copy it themselves.
        const email = button.parentElement?.querySelector('.email');
        if (email) {
          const range = document.createRange();
          range.selectNodeContents(email);
          window.getSelection()?.removeAllRanges();
          window.getSelection()?.addRange(range);
        }
        if (status) status.textContent = 'press Ctrl+C to copy';
      }
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (status) status.textContent = '';
      }, 2200);
    });
  });
</script>

<style>
  .contact {
    display: grid;
    gap: 6px;
  }

  .email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 22px;
    margin-top: 28px;
  }

  .email {
    font-size: clamp(1.5rem, 1rem + 2.2vw, 2.75rem);
    font-weight: 750;
    letter-spacing: -0.025em;
    text-decoration: underline;
    text-decoration-color: var(--marker);
    text-decoration-thickness: 3px;
    text-underline-offset: 8px;
    overflow-wrap: anywhere;
  }

  .copy {
    padding: 4px 0;
    border: 0;
    background: none;
    color: var(--marker);
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .status {
    color: var(--marker);
    font-size: 1.2rem;
    font-weight: 700;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin-top: 28px;
  }
</style>
