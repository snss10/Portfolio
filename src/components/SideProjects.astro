---
/**
 * Side projects, in the same form as the work list: what it is, a small
 * marker sketch of how it fits together, and where to go next.
 */
import Route from './Route.astro';
import { sideProjects } from '../data/projects';

const idOf = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<ul class="entries">
  {sideProjects.map((p, i) => (
    <li class={`entry tone-${p.tone}`} id={idOf(p.name)}>
      <p class="when">
        {p.license ? `Open source, ${p.license} licence` : 'Private code, not launched yet'}
      </p>
      <h3>{p.name}</h3>
      <p class="full">{p.kind}</p>
      <p class="summary">{p.description}</p>
      <div class="drawing">
        <Route
          label={p.sketch.label}
          route={{
            steps: p.sketch.steps.map((s) => s.title),
            notes: p.sketch.notes.map((n) => ({ at: n.at, text: n.text })),
            seed: 31 + i * 17,
          }}
        />
      </div>
      <ul class="ticks facts">
        {p.facts.map((f) => (
          <li>{f}</li>
        ))}
      </ul>
      <p class="meta">Built with {p.stack.join(', ')}.</p>
      <p class="links">
        {p.caseStudy && (
          <a class="link" href={p.caseStudy}>
            Read the {p.name} case study
          </a>
        )}
        {p.links.map((l) => (
          <a class="link" href={l.href} target="_blank" rel="noopener">
            {l.label}
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        ))}
      </p>
    </li>
  ))}
</ul>

<style>
  .entries {
    display: grid;
  }

  .entry {
    display: grid;
    justify-items: start;
    gap: 10px;
    padding-block: 44px;
    border-top: 1px solid var(--rule);
  }

  .entry:first-child {
    padding-top: 6px;
    border-top: 0;
  }

  .when,
  .meta {
    color: var(--ink-2);
    font-size: var(--fs-small);
  }

  h3 {
    font-size: clamp(1.75rem, 1.45rem + 1vw, 2.25rem);
    font-weight: 780;
    letter-spacing: -0.03em;
  }

  .full {
    color: var(--ink-2);
    font-weight: 600;
  }

  .summary,
  .facts {
    max-width: 40rem;
  }

  .drawing {
    width: 100%;
    max-width: 640px;
    margin-block: 10px 6px;
  }

  .facts {
    font-size: var(--fs-small);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin-top: 6px;
  }
</style>
