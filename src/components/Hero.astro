---
import Sketch from './Sketch.astro';
import MarkerButton from './MarkerButton.astro';
import { site, intro, lifecycle } from '../data/site';
---

<section class="hero page" aria-labelledby="hero-title">
  <div class="top">
    <div class="who">
      <h1 id="hero-title">{site.name}</h1>
      <p class="role">
        {site.role} in {site.location.split(',')[0]}
      </p>
    </div>
    <div class="what">
      <p class="statement">{intro.headline}</p>
      <p class="now">
        {site.currentTitle} at {site.companyShort}. {intro.now}
      </p>
      <div class="actions">
        <MarkerButton href={site.resume} download>
          Download resume (PDF)
        </MarkerButton>
        <a class="link" href={`mailto:${site.email}`}>
          Email
        </a>
        <a class="link" href={site.links.github} target="_blank" rel="me noopener">
          GitHub<span class="visually-hidden"> (opens in a new tab)</span>
        </a>
        <a class="link" href={site.links.linkedin} target="_blank" rel="me noopener">
          LinkedIn<span class="visually-hidden"> (opens in a new tab)</span>
        </a>
      </div>
    </div>
  </div>

  <div class="board">
    <p class="board-note hand" aria-hidden="true">
      how my work connects (each box opens its case study)
    </p>
    <Sketch flow={lifecycle} animate maxScale={1.32} class="board-sketch" />
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) clamp(2rem, 1rem + 3vw, 3.5rem);
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    align-items: start;
    gap: 28px clamp(2rem, 1rem + 4vw, 5rem);
  }

  .who {
    display: grid;
    gap: 14px;
  }

  .role {
    color: var(--ink-2);
    font-size: var(--fs-lead);
    font-weight: 560;
  }

  .what {
    display: grid;
    justify-items: start;
    gap: 14px;
    padding-top: 6px;
  }

  .statement {
    max-width: 28ch;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .now {
    max-width: 46ch;
    color: var(--ink-2);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 26px;
    margin-top: 12px;
  }

  .actions :global(.mbtn) {
    margin-left: -4px;
  }

  .board {
    display: grid;
    gap: 6px;
  }

  .board-note {
    color: var(--ink-2);
    font-size: 1.125rem;
    transform: rotate(-1deg);
    transform-origin: left;
  }

  .hero :global(.board-sketch svg) {
    margin-inline: auto;
  }

  @media (max-width: 900px) {
    .top {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
