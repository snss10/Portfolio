---
/**
 * The logo: a small whiteboard with "NS" written in marker, black N, blue S,
 * and an orange underline. It follows the theme; public/favicon.svg is the
 * same drawing with fixed colours.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 36, class: className } = Astro.props;
---

<svg
  class:list={['logo', className]}
  viewBox="0 0 64 64"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  <rect class="logo-board" x="3" y="3" width="58" height="58" rx="14"></rect>
  <path class="logo-n" d="M15 43V20l14 23V20"></path>
  <path
    class="logo-s"
    d="M49 23c-1.5-2.4-4.1-3.5-6.9-3.3-3.6.3-5.9 2.4-5.6 5.2.3 2.9 3 3.9 6.4 4.8 3.4.9 6.5 2.2 6.4 5.8-.1 3.2-3 5.3-6.7 5.3-3 0-5.6-1.2-7-3.5"
  ></path>
  <path class="logo-u" d="M14 51c8-1.2 23-1.8 35-.4"></path>
</svg>

<style>
  .logo {
    flex: none;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .logo-board {
    fill: var(--surface);
    stroke: var(--ink);
    stroke-width: 4;
  }

  .logo-n,
  .logo-s {
    stroke-width: 5.6;
  }

  .logo-n {
    stroke: var(--ink);
  }

  .logo-s {
    stroke: var(--blue);
  }

  .logo-u {
    stroke: var(--orange);
    stroke-width: 3.4;
  }
</style>
