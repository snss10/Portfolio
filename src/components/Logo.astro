---
/**
 * The logo: "ns" handwritten in marker, a black n and a blue s with a red
 * underline. No box around it. It follows the theme; public/favicon.svg is
 * the same drawing, with its own light and dark colours.
 */
interface Props {
  /** Height in px. The width follows the drawing's proportions. */
  size?: number;
  /** A square version with even margins, for app icons. */
  square?: boolean;
  class?: string;
}

const { size = 28, square = false, class: className } = Astro.props;
// The tight box around the letters, or a square centred on them.
const viewBox = square ? '0 7 64 64' : '2 18 60 42';
const width = square ? size : Math.round((size * 60) / 42);
---

<svg
  class:list={['logo', className]}
  viewBox={viewBox}
  width={width}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  <path
    class="logo-n"
    d="M8 45.5V24.5m0 7.5c2.4-5.4 6.2-8.2 10.6-8.2 5.6 0 8.6 3.6 8.6 9.6v12.1"
  ></path>
  <path
    class="logo-s"
    d="M54 27.8c-2-2.7-5-4.2-8.4-4.2-4.4 0-7.6 2.3-7.6 5.7 0 3.6 3.3 4.8 7.6 5.9 4.4 1.1 8.4 2.5 8.4 6.4 0 3.7-3.6 5.9-8.4 5.9-3.9 0-7.2-1.5-9.4-4.2"
  ></path>
  <path class="logo-u" d="M6 55.5c12-2 32-2.6 51-.4"></path>
</svg>

<style>
  .logo {
    flex: none;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .logo-n,
  .logo-s {
    stroke-width: 6.5;
  }

  .logo-n {
    stroke: var(--ink);
  }

  .logo-s {
    stroke: var(--blue);
  }

  .logo-u {
    stroke: var(--red);
    stroke-width: 4;
  }
</style>
